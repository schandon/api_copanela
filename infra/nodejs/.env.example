# ===========================================
# JRC BRASIL - API Estimates Production Environment
# ===========================================

# Application Configuration
# -------------------------
# API server host (use 0.0.0.0 for Docker, localhost for local development)
HOST_API=api.xxxxxxx.example.com

# Environment (development, staging, production)
NODE_ENV=development

# Database Configuration
# ---------------------
# SQL Server connection string
DATABASE_URL=sqlserver://username:password@host:port/database?encrypt=true&trustServerCertificate=true

# External API Configuration
# --------------------------
# API endpoint for external integrations
FINDVESSEL_API=https://api.bar.example.com

# Security Configuration
# ---------------------
# JWT secret key for token validation (MUST be changed in production)
# Generate a secure random string: openssl rand -base64 32
JWT_SECRET=YOURPASSWORD

# Docker Configuration
# -------------------
# Override default port mapping if needed
API_PORT=3333

# Docker image tag (used by docker-compose.yml)
# Default: "latest" for local development
# CI/CD pipeline overrides: "staging" for develop branch, "v1.x.x" or "latest" for production tags
IMAGE_TAG=latest

# Logging Configuration
# --------------------
# Log level (error, warn, info, debug)
LOG_LEVEL=info

# Health Check Configuration
# --------------------------
# Health check endpoint path
HEALTH_CHECK_PATH=/health

# Performance Configuration
# ------------------------
# Request timeout in milliseconds
REQUEST_TIMEOUT=30000

# Maximum request body size
MAX_BODY_SIZE=1048576

# Docker Networking
# -----------------
# Name of the Docker network to connect to (must exist)
NGINX_NETWORK_NAME=proxy_default

# Virtual Host Configuration
# --------------------------
# Domain name for the API (used by reverse proxy)
VIRTUAL_HOST=api.xxxxx.example.com

# Virtual Port for nginx-proxy (jwilder/nginx-proxy)
# ---------------------------------------------------
# Port the application listens on inside the container.
# nginx-proxy uses this to route traffic. Defaults to 80 if omitted,
# so it MUST be set when the app listens on a non-80 port (e.g. 3003).
# Should match API_PORT.
# VIRTUAL_PORT=3003

# ===========================================
# Environment-Specific Overrides
# ===========================================

# Development Environment
# ----------------------
# Uncomment and modify for development
# NODE_ENV=development
# HOST_API=localhost
# LOG_LEVEL=debug

# Staging Environment
# ------------------
# Uncomment and modify for staging
# NODE_ENV=staging
# LOG_LEVEL=info

# Production Environment
# ----------------------
# Uncomment and modify for production
# NODE_ENV=production
# LOG_LEVEL=warn
# JWT_SECRET=production-secure-jwt-secret

# ===========================================
# Security Notes
# ===========================================
# 1. Never commit this file with real credentials
# 2. Use environment-specific .env files
# 3. Rotate JWT secrets regularly
# 4. Use strong, unique passwords
# 5. Enable SSL/TLS for database connections
# 6. Restrict database access by IP when possible